# ══════════════════════════════════════════════════════════════
#  المحور الهندسي للمقاولات — متغيرات البيئة
# ══════════════════════════════════════════════════════════════
#  انسخ هذا الملف إلى .env.local واملأ القيم الحقيقية:
#      cp .env.example .env.local
#
#  تنبيه: لا توجد قيم افتراضية لأي سِرّ في الكود.
#  أي متغير ناقص أو ضعيف يمنع التطبيق من العمل في الإنتاج
#  بدلاً من تشغيله وهو مكشوف. راجع src/lib/env.ts
# ══════════════════════════════════════════════════════════════


# ── قاعدة البيانات (PostgreSQL / Supabase) ────────────────────

# رابط الاتصال المُجمَّع (pooled) — يستخدمه التطبيق في وقت التشغيل
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"

# رابط الاتصال المباشر — يستخدمه Prisma في الترحيلات (migrations)
DIRECT_URL="postgresql://user:password@host:5432/postgres"


# ── مصادقة لوحة التحكم ────────────────────────────────────────

# مفتاح توقيع جلسات الإدارة (HMAC-SHA256).
# الحد الأدنى 32 حرفاً. ولّده بأمر:
#     openssl rand -base64 48
# تغييره يُبطل كل الجلسات النشطة فوراً.
AUTH_SECRET="ضع-هنا-مفتاحاً-عشوائياً-لا-يقل-عن-32-حرفاً"

# رمز الدخول للوحة التحكم.
# 8 أحرف على الأقل، وتُحجب القيم الشائعة (123456، admin، …) في الإنتاج.
# ولّده بأمر:
#     node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
ADMIN_PASSCODE="ضع-هنا-رمزاً-قوياً"


# ── تخزين الصور (Supabase Storage) ────────────────────────────

# رابط مشروع Supabase — عام، يظهر في المتصفح
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"

# مفتاح الخدمة — يتجاوز كل قواعد RLS.
# سِرّ خطير: لا يُضاف له بادئة NEXT_PUBLIC_ ولا يُستخدم في كود المتصفح.
SUPABASE_SERVICE_ROLE_KEY="ضع-هنا-مفتاح-الخدمة"


# ── الموقع ────────────────────────────────────────────────────

# النطاق الكامل بدون شرطة مائلة في النهاية.
# يُستخدم في الروابط المطلقة و sitemap و JSON-LD.
NEXT_PUBLIC_SITE_URL="https://almahware.com"
